# Copia este fichero a .env para desarrollar en local.
# Los valores son de ejemplo: en producción la API se niega a arrancar con ellos.

NODE_ENV=development
PORT=3000

# Coincide con el servicio `db` de docker-compose.yml
DATABASE_URL=postgresql://devpilot:devpilot@localhost:5432/devpilot

# Secretos con los que se firman los tokens de sesión: 32 bytes o más y distintos entre sí.
# Para producción, genera cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=example-access-secret-change-me-0123456789
JWT_REFRESH_SECRET=example-refresh-secret-change-me-012345678

# Versión que devuelve /api/v1/health; en producción, el SHA del commit
APP_VERSION=dev

# Modelo de lenguaje. `fake` responde sin red ni clave: con una descripción de menos de 80
# caracteres hace preguntas y, si no, devuelve una especificación. En producción, `gemini`.
LLM_PROVIDER=fake
# Clave de Google AI Studio: solo en tu .env, nunca en el repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Espera del modelo simulado, para ver los estados de la interfaz
FAKE_LLM_LATENCY_MS=2500

# Límites de uso (RF-GEN-07)
GENERATION_DAILY_LIMIT_PER_USER=20
GENERATION_DAILY_LIMIT_GLOBAL=200
