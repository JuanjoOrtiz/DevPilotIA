{
  "name": "@devpilot/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Esquemas Zod y tipos que comparten el frontend y la API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schemas": "npm run build && node scripts/write-schemas.mjs"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  }
}
